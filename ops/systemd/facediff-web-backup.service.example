[Unit]
Description=Backup local cifrado do FaceDiff Web
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/run/facediff

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/facediff/current/deploy/web
EnvironmentFile=/etc/facediff/web-deploy.env
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ExecStart=/usr/bin/docker compose --env-file /etc/facediff/web-deploy.env --file /opt/facediff/current/deploy/web/compose.yaml --profile ops run --rm --no-deps backup
