# Copie para .env e ajuste. O .env real NUNCA vai para o Git.

# --- Conexao da aplicacao -------------------------------------------------
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql+psycopg://escola:troque-esta-senha@localhost:5433/escola

# Banco usado pelos testes de integracao. Precisa ser DIFERENTE do de cima:
# a suite apaga e recria o schema.
TEST_DATABASE_URL=postgresql+psycopg://escola:troque-esta-senha@localhost:5433/escola_test

# --- Aplicacao ------------------------------------------------------------
# Fuso usado para decidir a que "dia" uma presenca pertence.
APP_TIMEZONE=America/Sao_Paulo

# Diretorio das imagens de referencia. Fica fora do Git.
STORAGE_DIR=./storage/faces

# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Camera e reconhecimento ---------------------------------------------
# Indice da webcam usada pelo OpenCV.
CAMERA_INDEX=0
FACE_MODEL=Facenet512
FACE_DETECTOR=opencv

# Distancia cosseno maxima para aceitar duas faces como a mesma pessoa.
# 0.30 e o limiar do DeepFace para (Facenet512, cosine). A Fase 7 calibra
# este numero com FAR/FRR sobre dados reais.
# ATENCAO: trocar FACE_MODEL invalida todos os embeddings gravados.
# Rode 'python -m scripts.backfill_embeddings --apply' depois de mudar.
FACE_THRESHOLD=0.30

# --- Container de desenvolvimento (docker-compose.yml) --------------------
# Valores abaixo alimentam SOMENTE o container local.
POSTGRES_USER=escola
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=escola
# 5433 por padrao para nao colidir com um PostgreSQL nativo na 5432.
POSTGRES_PORT=5433
