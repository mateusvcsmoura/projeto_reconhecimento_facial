# Copie para .env e ajuste. O .env real NUNCA vai para o Git.

# --- Conexao da aplicacao -------------------------------------------------
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql+psycopg://escola:troque-esta-senha@localhost:5433/escola

# --- Aplicacao ------------------------------------------------------------
# Fuso usado para decidir a que "dia" uma presenca pertence.
APP_TIMEZONE=America/Sao_Paulo

# Diretorio das imagens de referencia. Fica fora do Git.
STORAGE_DIR=./storage/faces

# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Camera e reconhecimento ---------------------------------------------
# Indice da webcam usada pelo OpenCV.
CAMERA_INDEX=0

# Resolucao pedida a camera. O padrao do OpenCV costuma ser 640x480, o
# que produz um recorte de rosto pequeno -- e tanto o embedding quanto o
# anti-spoofing pioram com isso. A camera entrega a resolucao suportada
# mais proxima e a aplicacao avisa em log se nao atender ao pedido.
CAMERA_LARGURA=1280
CAMERA_ALTURA=720

# Backend de captura: auto | dshow | msmf | any
# 'auto' escolhe DirectShow no Windows. Medido nesta maquina:
#   Media Foundation (padrao do OpenCV)  ->  27 s ate o primeiro frame
#   DirectShow                           ->  0,8 s
# Nao mexa sem medir; a diferenca e de duas ordens de grandeza.
CAMERA_BACKEND=auto
FACE_MODEL=Facenet512
FACE_DETECTOR=opencv

# Distancia cosseno maxima para aceitar duas faces como a mesma pessoa.
# 0.30 e o limiar do DeepFace para (Facenet512, cosine). A Fase 7 calibra
# este numero com FAR/FRR sobre dados reais.
# ATENCAO: trocar FACE_MODEL invalida todos os embeddings gravados.
# Rode 'python -m scripts.backfill_embeddings --apply' depois de mudar.
FACE_THRESHOLD=0.30

# Recusa foto impressa ou tela no lugar da pessoa. Manter LIGADO:
# um controle de presenca burlavel com uma foto nao controla nada.
#
# ATENCAO: o modelo do DeepFace (MiniFASNet) produz falso positivo com
# alguma frequencia -- webcam de baixa resolucao e luz forte atras da
# pessoa sao as causas mais comuns. Se o cadastro de uma pessoa AO VIVO
# for recusado, melhore a iluminacao e aumente CAMERA_LARGURA/ALTURA
# antes de desligar. Desligar so em desenvolvimento.
FACE_ANTI_SPOOFING=true

# Busca e registra automaticamente apos uma sequencia temporal valida.
# False recupera o fluxo manual (ESPACO no cadastro e ENTER na presenca).
FACE_AUTO_CAPTURE_ENABLED=true
FACE_AUTO_CAPTURE_WAIT_SECONDS=5.0
FACE_AUTO_CAPTURE_SAMPLE_SECONDS=0.5
FACE_AUTO_CAPTURE_MAX_AGE_SECONDS=2.0

# Pontos faciais visuais apenas na janela de cadastro; nao alteram o frame salvo
# nem participam do reconhecimento. Requer o setup local documentado nos modelos.
FACE_LANDMARKS_ENABLED=false
FACE_LANDMARKS_MODEL_PATH=models/face_landmarker.task
FACE_LANDMARKS_PYTHON_PATH=.venv-landmarks/Scripts/python.exe

# Heuristicas de qualidade de captura. Sao optativas e nao foram calibradas
# com imagens faciais; false preserva a politica de aceitacao atual.
FACE_QUALITY_ENABLED=false
FACE_QUALITY_MIN_FACE_PX=80
FACE_QUALITY_MIN_BRIGHTNESS=40.0
FACE_QUALITY_MAX_BRIGHTNESS=215.0
FACE_QUALITY_MIN_SHARPNESS=100.0

# Exige observacoes consecutivas recentes da mesma identidade antes do registro.
# Valores iniciais de engenharia, sem calibracao biometrica; opt-in.
FACE_TEMPORAL_ENABLED=false
FACE_TEMPORAL_MIN_OBSERVATIONS=3
FACE_TEMPORAL_WINDOW_SECONDS=5.0
FACE_TEMPORAL_MAX_AGE_SECONDS=2.0

# Recusa identidades candidatas com separacao insuficiente (nao calibrado).
FACE_AMBIGUITY_ENABLED=false
# FACE_AMBIGUITY_MIN_MARGIN=0.0  # Descomente e habilite acima para recusar somente empates exatos.

# --- Retencao de dados ----------------------------------------------------
# Por quantos dias guardar as presencas. 0 desliga o expurgo.
# 1825 = 5 anos, prazo tipico de guarda de registro academico.
RETENCAO_PRESENCAS_DIAS=1825

# --- Container de desenvolvimento (docker-compose.yml) --------------------
# Valores abaixo alimentam SOMENTE o container local.
POSTGRES_USER=escola
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=escola
# 5433 por padrao para nao colidir com um PostgreSQL nativo na 5432.
POSTGRES_PORT=5433

# --- Runtime web local (docker compose --profile web up -d --build) --------
# Use a URL alcançável de dentro dos containers. Senhas especiais precisam
# estar codificadas para URL. Preserve a porta 5433 e o banco local existentes.
WEB_DATABASE_URL=postgresql+psycopg://escola:SENHA_CODIFICADA@host.docker.internal:5433/escola
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=gere-um-segredo-aleatorio-com-ao-menos-32-caracteres
WEB_RETENTION_DAYS=30
# Prazo demonstrativo do runtime local; configure um prazo aprovado ao usar dados reais.
WEB_PURPOSE_END_AT=2027-12-31T23:59:59-03:00
# Origem usada na protecao CSRF; abra esta URL no navegador.
WEB_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Pasta local já existente com os pesos DeepFace e MiniFASNet.
WEB_LOCAL_DEEPFACE_WEIGHTS_HOST_DIR=C:/Users/SEU_USUARIO/.deepface/weights
