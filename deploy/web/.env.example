# Copie para /etc/facediff/web-deploy.env fora do checkout e preencha no host.
# Nenhum valor deste exemplo e credencial real.
WEB_IMAGE_TAG=revisao-git-imutavel
WEB_DOMAIN=exemplo.invalid
CADDY_ACME_EMAIL=admin@example.invalid
WEB_PURPOSE_END_AT=2027-12-31T23:59:59-03:00
WEB_RETENTION_DAYS=30
WEB_APP_TIMEZONE=America/Sao_Paulo
WEB_NETWORK_CIDR=172.28.50.0/24
WEB_PUBLIC_REGISTRATION_CONTEXT_LIMIT_PER_MINUTE=10
WEB_PUBLIC_REGISTRATION_QUERY_LIMIT_PER_MINUTE=60
WEB_PUBLIC_REGISTRATION_ORIGIN_LIMIT_PER_MINUTE=600

# Arquivos com permissao restrita fora do repositorio.
POSTGRES_PASSWORD_FILE=/etc/facediff/secrets/postgres-admin-password
WEB_APP_DB_PASSWORD_FILE=/etc/facediff/secrets/web-app-db-password
WEB_MIGRATOR_DB_PASSWORD_FILE=/etc/facediff/secrets/web-migrator-db-password
WEB_DATABASE_URL_FILE=/etc/facediff/secrets/web-database-url
WEB_SECRET_KEY_FILE=/etc/facediff/secrets/web-secret-key
ALEMBIC_DATABASE_URL_FILE=/etc/facediff/secrets/alembic-database-url
WEB_BACKUP_PG_SERVICE_FILE=/etc/facediff/secrets/pg-service.conf
WEB_BACKUP_RCLONE_CONFIG_FILE=/etc/facediff/secrets/rclone.conf

# Bind mounts hosteados; temporarios devem existir em tmpfs /run/facediff.
WEB_CAPTURE_HOST_DIR=/run/facediff/captures
WEB_MAINTENANCE_HOST_DIR=/run/facediff/maintenance
WEB_MODELS_HOST_DIR=/srv/facediff/models
WEB_BACKUP_STAGING_HOST_DIR=/run/facediff/backup-staging
WEB_BACKUP_TRANSPORT_STAGING_HOST_DIR=/run/facediff/transport-staging

# Precos/lifecycle sao parametros iniciais de engenharia, pendentes da task019.
# O total de limites de memoria dos containers e 5.75 GiB; reserve RAM para SO,
# tmpfs e picos, e valide consumo real antes de qualquer uso operacional.
WEB_CADDY_CPU_LIMIT=0.25
WEB_CADDY_MEMORY_LIMIT=256m
WEB_APP_CPU_LIMIT=0.50
WEB_APP_MEMORY_LIMIT=768m
WEB_WORKER_CPU_LIMIT=1.25
WEB_WORKER_MEMORY_LIMIT=3g
WEB_POSTGRES_CPU_LIMIT=0.50
WEB_POSTGRES_MEMORY_LIMIT=1g
WEB_BACKUP_CPU_LIMIT=0.50
WEB_BACKUP_MEMORY_LIMIT=768m

# Nome do remote crypt local definido em rclone.conf. Sem remote externo,
# WEB_BACKUP_EXTERNAL_RAW_REMOTE pode permanecer vazio.
WEB_BACKUP_LOCAL_CRYPT_REMOTE=facediff-local-crypt:
WEB_BACKUP_EXTERNAL_RAW_REMOTE=
