{
	admin off
	email {$CADDY_ACME_EMAIL}
	http_port 8080
	https_port 8443
	servers {
		protocols h1 h2
	}
	log {
		output stdout
		format filter {
			wrap json
			request>uri delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
}

{$WEB_DOMAIN} {
	encode zstd gzip
	log {
		output stdout
		format filter {
			wrap json
			request>uri delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
	reverse_proxy app:8000
}
